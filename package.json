{
  "name": "atlasxis",
  "version": "1.0.2",
  "description": "Authorization proof engine for Next.js + Supabase APIs. Proves, per data sink, whether there is structural evidence of authorization — and says so when it can't. Never claims your app is secure.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "atlasxis": "core/cli.mjs"
  },
  "files": [
    "core/cli.mjs",
    "core/engine.mjs",
    "core/extract.mjs",
    "core/proofs.mjs",
    "core/ir.mjs",
    "core/rls.mjs",
    "core/report.mjs",
    "core/explanations.mjs",
    "core/reason-codes.mjs",
    "core/assumptions.mjs",
    "core/authz.mjs",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "scripts": {
    "ci": "node core/ci.mjs --public",
    "ci:public": "node core/ci.mjs --public",
    "scan": "node core/cli.mjs scan",
    "benchmark": "node core/benchmark/run.mjs",
    "test": "node core/ci.mjs --public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fisioterapeutah-star/atlasxis.git"
  },
  "homepage": "https://github.com/fisioterapeutah-star/atlasxis#readme",
  "bugs": {
    "url": "https://github.com/fisioterapeutah-star/atlasxis/issues"
  },
  "keywords": [
    "security",
    "authorization",
    "idor",
    "bola",
    "supabase",
    "rls",
    "nextjs",
    "static-analysis",
    "proof",
    "access-control"
  ]
}
